import { useEffect, useState } from "react";
import "./AdminDashboard.css";

function AdminDashboard({ onLogout }) {
  const adminEmail =
    localStorage.getItem("admin_email") || "admin@testflow.com";

  const [students, setStudents] = useState(0);
  const [tests, setTests] = useState(0);
  const [attempts, setAttempts] = useState(0);
  const [activeTests, setActiveTests] = useState(0);

  useEffect(() => {
    const animateCounter = (setter, target, duration = 1000) => {
      let start = 0;
      const increment = target / (duration / 20);

      const timer = setInterval(() => {
        start += increment;

        if (start >= target) {
          setter(target);
          clearInterval(timer);
        } else {
          setter(Math.floor(start));
        }
      }, 20);

      return () => clearInterval(timer);
    };

    const timers = [
      animateCounter(setStudents, 248),
      animateCounter(setTests, 36),
      animateCounter(setAttempts, 1284),
      animateCounter(setActiveTests, 8),
    ];

    return () => {
      timers.forEach((timer) => {
        if (typeof timer === "function") {
          timer();
        }
      });
    };
  }, []);

  return (
    <main className="admin-dashboard">

