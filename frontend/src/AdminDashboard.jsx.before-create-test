          </span>
        </div>

        <div className="admin-profile">

          <div className="admin-avatar">
            A
          </div>

          <div>
            <h3>Administrator</h3>
            <p>{adminEmail}</p>
          </div>

        </div>

        <nav className="admin-navigation">

