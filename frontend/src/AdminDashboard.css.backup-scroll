/* =========================================================
   TESTFLOW ADMIN DASHBOARD
   PREMIUM DARK SAAS THEME
========================================================= */

.admin-dashboard {
  min-height: 100vh;
  width: 100%;
  display: flex;

  background:
    radial-gradient(
      circle at 75% -10%,
      rgba(99, 102, 241, 0.18),
      transparent 32%
    ),
    radial-gradient(
      circle at 35% 100%,
      rgba(6, 182, 212, 0.08),
      transparent 30%
    ),
    #070b14;

  color: #e5e7eb;

  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  overflow-x: hidden;
}


/* =========================================================
   SIDEBAR
========================================================= */

.admin-sidebar {
  width: 260px;
  min-height: 100vh;
  flex-shrink: 0;

  display: flex;
  flex-direction: column;

  padding: 28px 18px 20px;

  background:
    linear-gradient(
      180deg,
      #0b1120 0%,
      #080d18 55%,
      #060a12 100%
    );

  border-right: 1px solid rgba(148, 163, 184, 0.08);

  color: white;

  position: relative;
  z-index: 5;

  animation: sidebarSlide 0.7s ease forwards;
}

.admin-sidebar::before {
  content: "";

  position: absolute;

  width: 220px;
  height: 220px;

  top: -100px;
  left: -100px;

  border-radius: 50%;

  background:
    rgba(99, 102, 241, 0.16);

  filter: blur(70px);

  pointer-events: none;
}


/* =========================================================
   BRAND
========================================================= */

.admin-brand {
  display: flex;
  align-items: center;

  gap: 11px;

  padding: 0 12px 28px;

  font-size: 21px;
  font-weight: 800;

  letter-spacing: 0.5px;
}

.admin-brand > span:last-child > span {
  color: #22d3ee;
}

.admin-brand-box {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 11px;

  background:
    linear-gradient(
      135deg,
      #6366f1,
      #06b6d4
    );

  box-shadow:
    0 0 30px rgba(99, 102, 241, 0.35);

  font-weight: 900;
}


/* =========================================================
   PROFILE
========================================================= */

.admin-profile {
  display: flex;
  align-items: center;

  gap: 12px;

  padding: 18px 12px;

  margin-bottom: 20px;

  border-top:
    1px solid rgba(255, 255, 255, 0.07);

  border-bottom:
    1px solid rgba(255, 255, 255, 0.07);
}

.admin-avatar,
.header-admin-avatar {
  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  font-weight: 800;
}

.admin-avatar {
  width: 43px;
  height: 43px;

  flex-shrink: 0;

  background:
    linear-gradient(
      135deg,
      #6366f1,
      #8b5cf6
    );

  box-shadow:
    0 0 25px rgba(99, 102, 241, 0.30);
}

.admin-profile h3 {
  margin: 0 0 4px;

  color: #f8fafc;

  font-size: 14px;
  font-weight: 700;
}

.admin-profile p {
  margin: 0;

  max-width: 150px;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;

  color: #64748b;

  font-size: 11px;
}


/* =========================================================
   NAVIGATION
========================================================= */

.admin-navigation {
  display: flex;
  flex-direction: column;

  gap: 7px;
}

.admin-navigation button {
  position: relative;

  border: 1px solid transparent;

  border-radius: 12px;

  padding: 13px 14px;

  display: flex;
  align-items: center;

  gap: 13px;

  background: transparent;

  color: #7f8da5;

  font-size: 14px;
  font-weight: 600;

  text-align: left;

  cursor: pointer;

  transition:
    transform 0.25s ease,
    background 0.25s ease,
    color 0.25s ease,
    border-color 0.25s ease;
}

.admin-navigation button span {
  width: 23px;

  text-align: center;

  font-size: 16px;
}

.admin-navigation button:hover {
  transform: translateX(4px);

  background:
    rgba(99, 102, 241, 0.08);

  color: #e2e8f0;
}

.admin-navigation button.active {
  background:
    linear-gradient(
      90deg,
      rgba(99, 102, 241, 0.22),
      rgba(6, 182, 212, 0.08)
    );

  border-color:
    rgba(99, 102, 241, 0.18);

  color: #ffffff;

  box-shadow:
    inset 3px 0 0 #6366f1,
    0 10px 30px rgba(0, 0, 0, 0.20);
}


/* =========================================================
   LOGOUT
========================================================= */

.admin-logout {
  margin-top: auto;

  border:
    1px solid rgba(255, 255, 255, 0.07);

  border-radius: 12px;

  padding: 13px 14px;

  display: flex;
  align-items: center;

  gap: 13px;

  background:
    rgba(255, 255, 255, 0.025);

  color: #7f8da5;

  font-size: 14px;
  font-weight: 600;

  cursor: pointer;

  transition: all 0.25s ease;
}

.admin-logout:hover {
  background:
    rgba(239, 68, 68, 0.10);

  color: #fca5a5;

  border-color:
    rgba(239, 68, 68, 0.20);
}


/* =========================================================
   MAIN
========================================================= */

.admin-main {
  flex: 1;

  min-width: 0;

  padding: 34px 38px 45px;

  background:
    radial-gradient(
      circle at 90% 0%,
      rgba(99, 102, 241, 0.08),
      transparent 28%
    );
}


/* =========================================================
   HEADER
========================================================= */

.admin-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 30px;

  margin-bottom: 32px;

  animation:
    fadeUp 0.65s ease 0.15s both;
}

.admin-header-label {
  margin: 0 0 7px;

  color: #818cf8;

  font-size: 11px;
  font-weight: 800;

  letter-spacing: 2px;
}

.admin-header h1 {
  margin: 0;

  color: #f8fafc;

  font-size: clamp(30px, 4vw, 40px);

  line-height: 1.1;

  font-weight: 800;

  letter-spacing: -1px;
}

.admin-header-subtitle {
  margin: 9px 0 0;

  color: #64748b;

  font-size: 14px;
}

.admin-header-actions {
  display: flex;
  align-items: center;

  gap: 18px;
}


/* =========================================================
   NOTIFICATION
========================================================= */

.notification-button {
  position: relative;

  width: 45px;
  height: 45px;

  border:
    1px solid rgba(148, 163, 184, 0.12);

  border-radius: 13px;

  background:
    rgba(15, 23, 42, 0.80);

  color: #e2e8f0;

  font-size: 17px;

  cursor: pointer;

  box-shadow:
    0 10px 30px rgba(0, 0, 0, 0.20);

  transition: all 0.25s ease;
}

.notification-button:hover {
  transform: translateY(-3px);

  border-color:
    rgba(99, 102, 241, 0.35);

  box-shadow:
    0 12px 35px rgba(99, 102, 241, 0.15);
}

.notification-button > span {
  position: absolute;

  width: 7px;
  height: 7px;

  top: 8px;
  right: 9px;

  border-radius: 50%;

  background: #22d3ee;

  border: 2px solid #0f172a;

  animation:
    notificationPulse 1.7s infinite;
}


/* =========================================================
   HEADER ADMIN
========================================================= */

.header-admin {
  display: flex;
  align-items: center;

  gap: 10px;
}

.header-admin-avatar {
  width: 42px;
  height: 42px;

  background:
    linear-gradient(
      135deg,
      rgba(99, 102, 241, 0.25),
      rgba(6, 182, 212, 0.18)
    );

  border:
    1px solid rgba(99, 102, 241, 0.20);

  color: #a5b4fc;

  box-shadow:
    0 0 20px rgba(99, 102, 241, 0.10);
}

.header-admin strong {
  display: block;

  color: #f1f5f9;

  font-size: 13px;
}

.header-admin small {
  display: block;

  margin-top: 2px;

  color: #64748b;

  font-size: 11px;
}


/* =========================================================
   STATISTICS
========================================================= */

.admin-stat-grid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 18px;

  margin-bottom: 24px;
}

.admin-stat-card {
  min-height: 142px;

  position: relative;

  overflow: hidden;

  display: flex;
  align-items: center;

  gap: 16px;

  padding: 22px;

  border:
    1px solid rgba(148, 163, 184, 0.10);

  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      rgba(17, 24, 39, 0.96),
      rgba(15, 23, 42, 0.88)
    );

  box-shadow:
    0 15px 40px rgba(0, 0, 0, 0.18);

  animation:
    cardAppear 0.65s ease both;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.admin-stat-card:hover {
  transform:
    translateY(-6px);

  border-color:
    rgba(99, 102, 241, 0.28);

  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.30),
    0 0 30px rgba(99, 102, 241, 0.06);
}

.admin-stat-card:nth-child(1) {
  animation-delay: 0.25s;
}

.admin-stat-card:nth-child(2) {
  animation-delay: 0.35s;
}

.admin-stat-card:nth-child(3) {
  animation-delay: 0.45s;
}

.admin-stat-card:nth-child(4) {
  animation-delay: 0.55s;
}


/* =========================================================
   STAT ICONS
========================================================= */

.stat-icon {
  width: 53px;
  height: 53px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 15px;

  font-size: 22px;

  transition:
    transform 0.3s ease;
}

.admin-stat-card:hover .stat-icon {
  transform:
    rotate(-6deg)
    scale(1.08);
}

.students-icon {
  background:
    rgba(99, 102, 241, 0.14);

  border:
    1px solid rgba(99, 102, 241, 0.20);
}

.tests-icon {
  background:
    rgba(139, 92, 246, 0.14);

  border:
    1px solid rgba(139, 92, 246, 0.20);
}

.attempts-icon {
  background:
    rgba(6, 182, 212, 0.13);

  border:
    1px solid rgba(6, 182, 212, 0.20);
}

.active-icon {
  background:
    rgba(16, 185, 129, 0.13);

  border:
    1px solid rgba(16, 185, 129, 0.20);
}


/* =========================================================
   STAT CONTENT
========================================================= */

.stat-content {
  position: relative;

  z-index: 2;
}

.stat-content p {
  margin: 0 0 6px;

  color: #71809a;

  font-size: 12px;

  font-weight: 600;
}

.stat-content h2 {
  margin: 0 0 5px;

  color: #f8fafc;

  font-size: 29px;

  line-height: 1;

  font-weight: 800;

  letter-spacing: -0.5px;
}

.stat-positive {
  color: #34d399;

  font-size: 11px;

  font-weight: 700;
}

.stat-neutral {
  color: #64748b;

  font-size: 11px;

  font-weight: 700;
}


/* =========================================================
   DECORATION
========================================================= */

.stat-decoration {
  position: absolute;

  right: -45px;
  bottom: -65px;

  width: 150px;
  height: 150px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(99, 102, 241, 0.12),
      transparent 70%
    );

  transition:
    transform 0.5s ease;
}

.admin-stat-card:hover .stat-decoration {
  transform:
    scale(1.5);
}


/* =========================================================
   CONTENT GRID
========================================================= */

.admin-content-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.55fr)
    minmax(310px, 1fr);

  gap: 20px;

  margin-bottom: 20px;
}


/* =========================================================
   PANELS
========================================================= */

.dashboard-panel {
  border:
    1px solid rgba(148, 163, 184, 0.10);

  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      rgba(17, 24, 39, 0.96),
      rgba(11, 18, 32, 0.92)
    );

  box-shadow:
    0 15px 40px rgba(0, 0, 0, 0.18);

  overflow: hidden;

  animation:
    fadeUp 0.7s ease 0.55s both;

  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease;
}

.dashboard-panel:hover {
  border-color:
    rgba(99, 102, 241, 0.16);

  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.24);
}


/* =========================================================
   PANEL HEADER
========================================================= */

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 22px 24px;

  border-bottom:
    1px solid rgba(148, 163, 184, 0.08);
}

.panel-header h2 {
  margin: 0 0 5px;

  color: #f1f5f9;

  font-size: 17px;
}

.panel-header p {
  margin: 0;

  color: #64748b;

  font-size: 11px;
}

.view-all-button {
  border: 0;

  background: transparent;

  color: #818cf8;

  font-size: 12px;

  font-weight: 700;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    color 0.2s ease;
}

.view-all-button:hover {
  transform:
    translateX(4px);

  color: #22d3ee;
}


/* =========================================================
   TEST LIST
========================================================= */

.test-list {
  padding: 5px 24px 12px;
}

.test-row {
  display: flex;
  align-items: center;

  gap: 13px;

  padding: 17px 0;

  border-bottom:
    1px solid rgba(148, 163, 184, 0.07);

  transition:
    transform 0.25s ease,
    background 0.25s ease;
}

.test-row:last-child {
  border-bottom: 0;
}

.test-row:hover {
  transform:
    translateX(5px);
}


/* =========================================================
   TEST ICONS
========================================================= */

.test-row-icon {
  width: 40px;
  height: 40px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 11px;

  font-size: 13px;

  font-weight: 800;
}

.math-icon {
  background:
    rgba(99, 102, 241, 0.13);

  color: #a5b4fc;
}

.physics-icon {
  background:
    rgba(139, 92, 246, 0.13);

  color: #c4b5fd;
}

.cs-icon {
  background:
    rgba(16, 185, 129, 0.12);

  color: #6ee7b7;
}


/* =========================================================
   TEST INFO
========================================================= */

.test-info {
  flex: 1;

  min-width: 0;
}

.test-info strong {
  display: block;

  margin-bottom: 4px;

  color: #e2e8f0;

  font-size: 13px;
}

.test-info span {
  color: #64748b;

  font-size: 10px;
}


/* =========================================================
   STATUS
========================================================= */

.status {
  padding: 5px 10px;

  border-radius: 20px;

  font-size: 9px;

  font-weight: 800;
}

.active-status {
  background:
    rgba(16, 185, 129, 0.12);

  color: #34d399;

  border:
    1px solid rgba(16, 185, 129, 0.15);
}

.scheduled-status {
  background:
    rgba(99, 102, 241, 0.13);

  color: #a5b4fc;

  border:
    1px solid rgba(99, 102, 241, 0.16);
}

.draft-status {
  background:
    rgba(100, 116, 139, 0.12);

  color: #94a3b8;
}


/* =========================================================
   QUICK ACTIONS
========================================================= */

.quick-actions {
  padding: 8px 16px 16px;
}

.quick-actions button {
  width: 100%;

  display: flex;
  align-items: center;

  gap: 12px;

  border: 0;

  border-radius: 12px;

  padding: 13px 9px;

  background: transparent;

  text-align: left;

  cursor: pointer;

  transition:
    transform 0.25s ease,
    background 0.25s ease;
}

.quick-actions button:hover {
  transform:
    translateX(5px);

  background:
    rgba(99, 102, 241, 0.06);
}

.quick-icon {
  width: 39px;
  height: 39px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 11px;

  background:
    rgba(99, 102, 241, 0.13);

  color: #a5b4fc;

  font-size: 16px;
}

.quick-actions button:nth-child(2) .quick-icon {
  background:
    rgba(139, 92, 246, 0.13);

  color: #c4b5fd;
}

.quick-actions button:nth-child(3) .quick-icon {
  background:
    rgba(16, 185, 129, 0.12);

  color: #6ee7b7;
}

.quick-actions button:nth-child(4) .quick-icon {
  background:
    rgba(6, 182, 212, 0.12);

  color: #67e8f9;
}

.quick-actions button div {
  flex: 1;
}

.quick-actions strong {
  display: block;

  color: #e2e8f0;

  font-size: 12px;
}

.quick-actions small {
  display: block;

  margin-top: 3px;

  color: #64748b;

  font-size: 9px;
}

.quick-actions b {
  color: #475569;

  font-size: 14px;

  transition:
    transform 0.25s ease,
    color 0.25s ease;
}

.quick-actions button:hover b {
  transform:
    translateX(4px);

  color: #22d3ee;
}


/* =========================================================
   ACTIVITY
========================================================= */

.activity-panel {
  margin-bottom: 10px;
}

.activity-list {
  padding: 5px 24px 12px;
}

.activity-item {
  position: relative;

  display: flex;
  align-items: center;

  gap: 14px;

  padding: 17px 0;

  border-bottom:
    1px solid rgba(148, 163, 184, 0.07);
}

.activity-item:last-child {
  border-bottom: 0;
}

.activity-dot {
  width: 10px;
  height: 10px;

  flex-shrink: 0;

  border-radius: 50%;

  background:
    linear-gradient(
      135deg,
      #6366f1,
      #22d3ee
    );

  box-shadow:
    0 0 0 5px rgba(99, 102, 241, 0.09);

  animation:
    activityPulse 2s infinite;
}

.activity-content {
  flex: 1;
}

.activity-content strong {
  display: block;

  margin-bottom: 4px;

  color: #e2e8f0;

  font-size: 12px;
}

.activity-content p {
  margin: 0;

  color: #64748b;

  font-size: 10px;
}

.activity-item > span {
  flex-shrink: 0;

  color: #475569;

  font-size: 9px;
}


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes sidebarSlide {
  from {
    opacity: 0;
    transform: translateX(-35px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(22px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes cardAppear {
  from {
    opacity: 0;
    transform:
      translateY(25px)
      scale(0.97);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}

@keyframes notificationPulse {
  0% {
    box-shadow:
      0 0 0 0 rgba(34, 211, 238, 0.40);
  }

  70% {
    box-shadow:
      0 0 0 7px rgba(34, 211, 238, 0);
  }

  100% {
    box-shadow:
      0 0 0 0 rgba(34, 211, 238, 0);
  }
}

@keyframes activityPulse {
  0% {
    box-shadow:
      0 0 0 5px rgba(99, 102, 241, 0.10);
  }

  50% {
    box-shadow:
      0 0 0 8px rgba(34, 211, 238, 0.04);
  }

  100% {
    box-shadow:
      0 0 0 5px rgba(99, 102, 241, 0.10);
  }
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1100px) {

  .admin-stat-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .admin-content-grid {
    grid-template-columns: 1fr;
  }
}


@media (max-width: 800px) {

  .admin-sidebar {
    width: 215px;
  }

  .admin-main {
    padding:
      25px 20px 35px;
  }

  .admin-header {
    flex-direction: column;
  }
}


@media (max-width: 600px) {

  .admin-dashboard {
    flex-direction: column;
  }

  .admin-sidebar {
    width: 100%;
    min-height: auto;
    padding: 18px;
  }

  .admin-profile {
    display: none;
  }

  .admin-navigation {
    flex-direction: row;
    overflow-x: auto;
  }

  .admin-navigation button {
    min-width: max-content;
  }

  .admin-logout {
    margin-top: 15px;
  }

  .admin-main {
    padding:
      22px 15px 30px;
  }

  .admin-stat-grid {
    grid-template-columns: 1fr;
  }

  .admin-header-actions {
    width: 100%;
    justify-content: space-between;
  }

  .panel-header {
    padding: 18px;
  }

  .test-list,
  .activity-list {
    padding-left: 18px;
    padding-right: 18px;
  }

  .test-row {
    flex-wrap: wrap;
  }

  .status {
    margin-left: 52px;
  }
}


@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;

    animation-iteration-count: 1 !important;

    transition-duration: 0.01ms !important;
  }
}